# -------------------------------------------
# SpotiHost Configuration
# -------------------------------------------


# Database Configuration
DB_USER=spotihost_user
DB_PASSWORD=your_secure_password_here
DB_NAME=spotihost_db
DB_PORT=5432 # default is 5432


# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Application Settings
PORT=8000 # default is 8000

# Redirect URI after Spotify login
# Local: http://127.0.0.1:8000/callback
# Remember to use the application port from above if changed
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback
